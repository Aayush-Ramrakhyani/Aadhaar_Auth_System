# Application
NODE_ENV=development
PORT=5001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5174

# Authentication Provider: "mock" or "uidai"
AADHAAR_PROVIDER=mock

# Mock provider (development only)
MOCK_OTP=123456

# --- Official UIDAI Integration (leave blank until credentials are obtained) ---
# These fields are required only when AADHAAR_PROVIDER=uidai
UIDAI_BASE_URL=
UIDAI_CLIENT_ID=
UIDAI_CLIENT_SECRET=
UIDAI_AUA_CODE=
UIDAI_SUB_AUA_CODE=
UIDAI_LICENSE_KEY=
UIDAI_CERTIFICATE_PATH=

# Tathya provider scaffold (requires authorized payload specification)
# AADHAAR_PROVIDER=tathya
TATHYA_BASE_URL=https://tathya.uidai.gov.in
